---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const blogPosts = await getCollection("blog");
const publishedPosts = blogPosts
  .filter((post) => post.data.published)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { month: "short", day: "2-digit" });
}

const recentPosts = publishedPosts.slice(0, 4);

const recentArt = [
  { src: "/images/art/Bull.jpg", title: "Bull" },
  { src: "/images/art/Falling-Through.jpg", title: "Falling Through" },
  { src: "/images/art/Birds-And-Fishes.jpg", title: "Birds And Fishes" },
  { src: "/images/art/Creation.jpg", title: "Creation" },
  { src: "/images/art/Palms.jpg", title: "Palms" },
  { src: "/images/art/Remain-In-Light.jpg", title: "Remain In Light" },
];

const thumb = (src: string) =>
  src
    .replace("/images/art/", "/images/art/thumbs/")
    .replace(/\.(jpg|png)$/, ".webp");

const projects = [
  {
    name: "foodlistnyc.com",
    href: "https://foodlistnyc.com",
    desc: "Repository of tagged posts from r/foodnyc over the past 3 years.",
  },
  {
    name: "stuffiminto.com",
    href: "https://stuffiminto.com/users/chris",
    desc: "Media sharing site similar to Linktree",
  },
];
---

<Layout title="Christopher Coyne's blog and portfolio">
  <div class="content-col">
    <!-- About -->
    <section class="tile about">
      <div class="tile-head">
        <span class="eyebrow">About</span>
      </div>
      <div class="about-body">
        <div class="about-text">
          <p>
            My name is Chris. I work as a software developer in NYC, but I'm
            originally from New Jersey. This is a place for me to share
            everything I've worked on over the years, including projects, art,
            writing, and anything else. I'm most interested in music, internet
            subcultures, and the intersection between AI and human purpose.
          </p>
        </div>
        <img
          class="about-photo"
          src="/images/mypics/headshot.webp"
          alt="Chris Coyne"
          width="1440"
          height="960"
        />
      </div>
      <div class="about-links">
        <a
          href="https://www.surrealcoding.com"
          target="_blank"
          rel="noopener noreferrer">Tech blog ↗</a
        >
        <a
          href="https://github.com/christopher-coyne"
          target="_blank"
          rel="noopener noreferrer">Github ↗</a
        >
        <a
          href="https://www.linkedin.com/in/christopher-coyne/"
          target="_blank"
          rel="noopener noreferrer">LinkedIn ↗</a
        >
      </div>
    </section>

    <!-- Art -->
    <section class="tile">
      <div class="tile-head">
        <span class="eyebrow">Art</span>
        <a class="tile-link" href="/art">View all →</a>
      </div>
      <div class="art-grid" aria-label="Recent artwork">
        {
          recentArt.map((art) => (
            <a href="/art" aria-label={art.title}>
              <img src={thumb(art.src)} alt={art.title} loading="lazy" />
            </a>
          ))
        }
      </div>
    </section>

    <!-- Writing -->
    <section class="tile">
      <div class="tile-head">
        <span class="eyebrow">Recent writing</span>
        <a class="tile-link" href="/blog">All posts →</a>
      </div>
      <div class="post-list">
        {
          recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} data-astro-prefetch="hover">
              <span>{post.data.title}</span>
              <time datetime={post.data.date}>
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Projects -->
    <section class="tile">
      <div class="tile-head">
        <span class="eyebrow">Projects</span>
        <a
          class="tile-link"
          href="https://github.com/christopher-coyne"
          target="_blank"
          rel="noopener noreferrer">github.com/christopher-coyne ↗</a
        >
      </div>
      <div class="proj-list">
        {
          projects.map((p) => (
            <div class="proj">
              <a
                class="proj-name"
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {p.name}
                <span class="proj-arrow">↗</span>
              </a>
              <span class="proj-desc">{p.desc}</span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-body {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }
  .about-text {
    flex: 1;
    min-width: 0;
  }
  .about p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .about-photo {
    flex: none;
    width: 104px;
    height: 104px;
    object-fit: cover;
    object-position: 65% 50%;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .about-body {
      flex-direction: column-reverse;
    }
    .about-photo {
      width: 88px;
      height: 88px;
    }
  }
  .about p + p {
    margin-top: 10px;
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
  }
  .about-links a {
    color: var(--ink-soft);
    font-size: 15px;
    text-decoration: underline;
    text-decoration-color: var(--ink-faint);
    text-underline-offset: 3px;
  }
  .about-links a:hover,
  .about-links a:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .art-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .art-grid a {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(135deg, var(--thumb-a) 0%, var(--thumb-b) 100%);
  }
  .art-grid a:hover,
  .art-grid a:focus-visible {
    border-color: var(--ink-faint);
  }
  .art-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }
  .post-list a {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 15.5px;
    color: var(--ink);
    text-decoration: none;
  }
  .post-list a:first-child {
    padding-top: 0;
  }
  .post-list a:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .post-list a:hover span,
  .post-list a:focus-visible span {
    color: var(--accent);
  }
  .post-list time {
    font-size: 13px;
    color: var(--ink-faint);
    white-space: nowrap;
  }

  .proj {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .proj:first-child {
    padding-top: 0;
  }
  .proj:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .proj-name {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
    background: var(--chip);
    padding: 3px 10px;
    border-radius: var(--radius);
    text-decoration: none;
  }
  .proj-name:hover,
  .proj-name:focus-visible {
    background: var(--accent-soft);
    color: var(--accent-deep);
  }
  .proj-arrow {
    font-size: 12px;
  }
  .proj-desc {
    font-size: 15px;
    color: var(--ink-soft);
  }
</style>
