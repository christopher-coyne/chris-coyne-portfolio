---
import Layout from "../../layouts/Layout.astro";

const artworks = [
  { src: "/images/art/Bull.jpg", title: "Bull" },
  { src: "/images/art/Falling-Through.jpg", title: "Falling Through" },
  { src: "/images/art/Birds-And-Fishes.jpg", title: "Birds And Fishes" },
  { src: "/images/art/Creation.jpg", title: "Creation" },
  { src: "/images/art/Palms.jpg", title: "Palms" },
  { src: "/images/art/Remain-In-Light.jpg", title: "Remain In Light" },
  { src: "/images/art/Prospero.jpg", title: "Prospero" },
  { src: "/images/art/Memory.jpg", title: "Memory" },
  { src: "/images/art/The-Angel.jpg", title: "The Angel" },
  { src: "/images/art/bull-distort1.png", title: "Bull Distort 1" },
  { src: "/images/art/bull-1.png", title: "Bull 1" },
  { src: "/images/art/bull-mutated.png", title: "Bull Mutated" },
  { src: "/images/art/node-a.png", title: "Node A" },
  { src: "/images/art/node-b.png", title: "Node B" },
  { src: "/images/art/node-c.png", title: "Node C" },
  { src: "/images/art/node-d.png", title: "Node D" },
  { src: "/images/art/node-e.png", title: "Node E" },
  { src: "/images/art/node-f.png", title: "Node F" },
  { src: "/images/art/node-g.png", title: "Node G" },
  { src: "/images/art/node-h.png", title: "Node H" },
  { src: "/images/art/node-i.png", title: "Node I" },
  { src: "/images/art/node-j.png", title: "Node J" },
  { src: "/images/art/node-k.png", title: "Node K" },
];
---

<Layout title="Christopher Coyne's art">
  <section class="page">
    <h2 class="page-title">Art</h2>
    <p class="page-sub">Traditional and digital work.</p>

    <div class="page-art-grid">
      {
        artworks.map((art) => (
          <figure>
            <button
              class="art-item"
              data-src={art.src}
              data-alt={art.title}
              aria-label={`View ${art.title}`}
            >
              <img src={art.src} alt={art.title} loading="lazy" />
            </button>
            <figcaption>{art.title}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Modal -->
  <div id="artModal" class="art-modal">
    <button id="closeModal" class="modal-close" aria-label="Close modal"
      >&times;</button
    >
    <img id="modalImg" src="" alt="" class="modal-img" />
  </div>
</Layout>

<style>
  .page-art-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  figure {
    margin: 0;
  }
  .art-item {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--thumb-a) 0%, var(--thumb-b) 100%);
  }
  .art-item:hover,
  .art-item:focus-visible {
    border-color: var(--ink-faint);
  }
  .art-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  figcaption {
    font-size: 14.5px;
    margin-top: 8px;
  }

  .art-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .art-modal.open {
    display: flex;
  }
  .modal-img {
    max-width: 95vw;
    max-height: 95vh;
    object-fit: contain;
  }
  .modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 2rem;
    z-index: 51;
    line-height: 1;
  }
  .modal-close:hover {
    color: white;
  }

  @media (max-width: 760px) {
    .page-art-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>

<script>
  function init() {
    const modal = document.getElementById("artModal");
    const modalImg = document.getElementById(
      "modalImg",
    ) as HTMLImageElement | null;
    const closeBtn = document.getElementById("closeModal");
    if (!modal || !modalImg) return;

    document.querySelectorAll(".art-item").forEach((item) => {
      item.addEventListener("click", () => {
        modalImg.src = item.getAttribute("data-src") || "";
        modalImg.alt = item.getAttribute("data-alt") || "";
        modal.classList.add("open");
      });
    });

    const close = () => modal.classList.remove("open");
    closeBtn?.addEventListener("click", close);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  document.addEventListener("astro:page-load", init);
</script>
