---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const blogPosts = await getCollection("blog");
const publishedPosts = blogPosts
  .filter((post) => post.data.published)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "2-digit",
    year: "numeric",
  });
}
---

<Layout title="Christopher Coyne's Blog">
  <section class="page">
    <h2 class="page-title">Blog</h2>
    <p class="page-sub">
      Thoughts on art, internet culture, music, and everything else.
    </p>

    <div class="page-post-list">
      {
        publishedPosts.map((post) => (
          <article>
            <a class="post-head" href={`/blog/${post.slug}`}>
              <h3 class="title">{post.data.title}</h3>
              <time datetime={post.data.date}>
                {formatDate(post.data.date)}
              </time>
            </a>
            {post.data.summary && <p>{post.data.summary}</p>}
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .page-post-list article {
    padding: 18px 0;
    border-bottom: 1px solid var(--line-soft);
  }
  .page-post-list article:last-of-type {
    border-bottom: none;
  }
  .page-post-list article:first-child {
    padding-top: 0;
  }
  .post-head {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    text-decoration: none;
    color: inherit;
  }
  .post-head h3 {
    font-size: 18px;
    font-weight: 500;
  }
  .post-head:hover h3,
  .post-head:focus-visible h3 {
    color: var(--accent);
  }
  .page-post-list time {
    font-size: 13px;
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .page-post-list p {
    font-size: 15px;
    color: var(--ink-soft);
    margin-top: 5px;
    max-width: 62ch;
  }
</style>
