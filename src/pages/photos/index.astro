---
import Layout from "../../layouts/Layout.astro";
import manifest from "../../data/photos/manifest.json";

type Item = (typeof manifest.photos)[number] & {
  video?: string;
  durationMs?: number;
  hidden?: boolean;
  tags?: string[];
  location?: string;
};

const items = (manifest.photos as Item[])
  .filter((p) => p.published && !p.hidden)
  .sort((a, b) => b.takenAt.localeCompare(a.takenAt));

const tagCounts = new Map<string, number>();
for (const p of items)
  for (const t of p.tags ?? []) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([t]) => t);

const locCounts = new Map<string, number>();
for (const p of items)
  if (p.location)
    locCounts.set(p.location, (locCounts.get(p.location) ?? 0) + 1);
const allLocations = [...locCounts.keys()].sort((a, b) => a.localeCompare(b));

const duration = (ms = 0) => {
  const s = Math.round(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
};
const full = (file: string) => `/images/photos/${file}`;
const thumb = (file: string) => `/images/photos/thumbs/${file}`;
const video = (file: string) => `/images/photos/videos/${file}`;
---

<Layout title="Christopher Coyne's photos">
  <section class="page">
    <h2 class="page-title">Photos</h2>
    <div class="filters">
      {
        allLocations.length > 0 && (
          <div class="loc-picker" id="locPicker">
            <button
              class="loc-toggle"
              id="locToggle"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="locPanel"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              <span id="locLabel">Anywhere</span>
              <svg
                class="loc-chevron"
                width="12"
                height="12"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 6l4 4 4-4" />
              </svg>
            </button>
            <div class="loc-panel" id="locPanel" hidden>
              <input
                type="search"
                id="locSearch"
                class="loc-search"
                placeholder="Search locations"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search locations"
              />
              <ul class="loc-list" id="locList" role="listbox">
                <li
                  class="loc-option is-on"
                  role="option"
                  data-value=""
                  aria-selected="true"
                >
                  <span>Anywhere</span>
                  <span class="loc-count">{items.length}</span>
                </li>
                {allLocations.map((l) => (
                  <li
                    class="loc-option"
                    role="option"
                    data-value={l}
                    aria-selected="false"
                  >
                    <span>{l}</span>
                    <span class="loc-count">{locCounts.get(l)}</span>
                  </li>
                ))}
              </ul>
              <p class="loc-empty" id="locEmpty" hidden>
                No matching locations
              </p>
            </div>
          </div>
        )
      }
      {
        allTags.length > 0 && (
          <div class="tag-bar" role="group" aria-label="Filter by tag">
            <button
              class="tag-chip is-on"
              data-kind="tag"
              data-value=""
              aria-pressed="true"
            >
              All
            </button>
            {allTags.map((t) => (
              <button
                class="tag-chip"
                data-kind="tag"
                data-value={t}
                aria-pressed="false"
              >
                {t}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="photo-grid">
      {
        items.map((p) => {
          const isVideo = p.type === "video" && p.video;
          const kind = isVideo ? "Video" : "Photo";
          const label =
            p.caption || (p.location ? `${kind} in ${p.location}` : kind);
          return (
            <button
              class:list={["photo-item", { "is-video": isVideo }]}
              data-src={isVideo ? video(p.video!) : full(p.file)}
              data-type={isVideo ? "video" : "photo"}
              data-poster={thumb(p.file)}
              data-alt={label}
              data-caption={p.caption}
              data-tags={(p.tags ?? []).join(",")}
              data-location={p.location ?? ""}
              aria-label={`View ${label.toLowerCase()}`}
            >
              <img
                src={thumb(p.file)}
                alt={label}
                width={p.width}
                height={p.height}
                loading="lazy"
              />
              {isVideo && (
                <span class="video-badge" aria-hidden="true">
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                  >
                    <path d="M4 2.5v11l9-5.5z" />
                  </svg>
                  {duration(p.durationMs)}
                </span>
              )}
            </button>
          );
        })
      }
    </div>
  </section>

  <div id="photoModal" class="photo-modal">
    <button id="closeModal" class="modal-close" aria-label="Close modal"
      >&times;</button
    >
    <button
      id="prevPhoto"
      class="modal-nav modal-prev"
      aria-label="Previous photo">&lsaquo;</button
    >
    <figure class="modal-figure">
      <img id="modalImg" src="" alt="" class="modal-media" hidden />
      <video
        id="modalVideo"
        class="modal-media"
        controls
        playsinline
        preload="none"
        hidden></video>
      <figcaption id="modalCaption" class="modal-caption"></figcaption>
    </figure>
    <button id="nextPhoto" class="modal-nav modal-next" aria-label="Next photo"
      >&rsaquo;</button
    >
  </div>
</Layout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-bottom: 18px;
  }
  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* ---------- location picker ---------- */
  .loc-picker {
    position: relative;
    order: 1;
    margin-left: auto;
  }
  .loc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13.5px;
    color: var(--ink);
    background: var(--tile);
    line-height: 1.3;
  }
  .loc-toggle:hover,
  .loc-toggle:focus-visible,
  .loc-toggle[aria-expanded="true"] {
    border-color: var(--ink-faint);
  }
  .loc-chevron {
    color: var(--ink-faint);
    transition: transform 0.2s ease;
  }
  .loc-toggle[aria-expanded="true"] .loc-chevron {
    transform: rotate(180deg);
  }
  .loc-panel {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 20;
    width: min(280px, calc(100vw - 32px));
    padding: 8px;
    background: var(--tile);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
  }
  .loc-search {
    width: 100%;
    padding: 7px 10px;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    outline: none;
  }
  .loc-search:focus {
    border-color: var(--ink-faint);
  }
  .loc-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    max-height: 260px;
    overflow-y: auto;
  }
  .loc-option {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 6px 9px;
    border-radius: 5px;
    font-size: 14px;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .loc-option:hover,
  .loc-option.is-active {
    background: var(--hover-wash);
    color: var(--ink);
  }
  .loc-option.is-on {
    color: var(--ink);
    font-weight: 600;
  }
  .loc-option[hidden] {
    display: none;
  }
  .loc-count {
    font-size: 12.5px;
    font-weight: 400;
    color: var(--ink-faint);
  }
  .loc-empty {
    margin: 8px 9px 4px;
    font-size: 13.5px;
    color: var(--ink-faint);
  }
  .tag-chip {
    padding: 4px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13.5px;
    color: var(--ink-soft);
    background: transparent;
    line-height: 1.3;
  }
  .tag-chip:hover,
  .tag-chip:focus-visible {
    border-color: var(--ink-faint);
    color: var(--ink);
  }
  .tag-chip.is-on {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .photo-item[hidden] {
    display: none;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .photo-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--thumb-a) 0%, var(--thumb-b) 100%);
  }
  .photo-item:hover,
  .photo-item:focus-visible {
    border-color: var(--ink-faint);
  }
  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .video-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 7px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.65);
    color: #fff;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    pointer-events: none;
  }

  /* ---------- modal ---------- */
  .photo-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .photo-modal.open {
    display: flex;
  }
  .modal-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .modal-media {
    max-width: 95vw;
    max-height: 88vh;
    object-fit: contain;
  }
  .modal-caption {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    text-align: center;
  }
  .modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 2rem;
    z-index: 51;
    line-height: 1;
  }
  .modal-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255, 255, 255, 0.7);
    font-size: 3rem;
    line-height: 1;
    padding: 0 0.75rem;
    z-index: 51;
  }
  .modal-prev {
    left: 0.5rem;
  }
  .modal-next {
    right: 0.5rem;
  }
  .modal-close:hover,
  .modal-nav:hover {
    color: white;
  }

  @media (max-width: 760px) {
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .modal-nav {
      font-size: 2.25rem;
      padding: 0 0.4rem;
    }
  }
</style>

<script>
  function init() {
    const modal = document.getElementById("photoModal");
    const img = document.getElementById("modalImg") as HTMLImageElement | null;
    const vid = document.getElementById(
      "modalVideo",
    ) as HTMLVideoElement | null;
    const caption = document.getElementById("modalCaption");
    const closeBtn = document.getElementById("closeModal");
    const prevBtn = document.getElementById("prevPhoto");
    const nextBtn = document.getElementById("nextPhoto");
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".photo-item"),
    );
    if (!modal || !img || !vid || !caption || items.length === 0) return;

    let current = 0;
    const chips = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".tag-chip"),
    );
    const visible = () => items.filter((el) => !el.hidden);

    const filter = { tag: "", location: "" };

    // Location dropdown
    const picker = document.getElementById("locPicker");
    const locToggle = document.getElementById("locToggle");
    const locPanel = document.getElementById("locPanel");
    const locSearch = document.getElementById(
      "locSearch",
    ) as HTMLInputElement | null;
    const locLabel = document.getElementById("locLabel");
    const locEmpty = document.getElementById("locEmpty");
    const options = Array.from(
      document.querySelectorAll<HTMLElement>(".loc-option"),
    );
    let active = -1;

    const applyFilter = (push = true) => {
      items.forEach((el) => {
        const tags = (el.dataset.tags || "").split(",").filter(Boolean);
        const tagOk = !filter.tag || tags.includes(filter.tag);
        const locOk =
          !filter.location || el.dataset.location === filter.location;
        el.hidden = !(tagOk && locOk);
      });
      chips.forEach((c) => {
        const on = (c.dataset.value || "") === filter.tag;
        c.classList.toggle("is-on", on);
        c.setAttribute("aria-pressed", String(on));
      });
      options.forEach((o) => {
        const on = (o.dataset.value || "") === filter.location;
        o.classList.toggle("is-on", on);
        o.setAttribute("aria-selected", String(on));
      });
      if (locLabel) locLabel.textContent = filter.location || "Anywhere";
      if (push) {
        const url = new URL(location.href);
        for (const k of ["tag", "location"] as const) {
          if (filter[k]) url.searchParams.set(k, filter[k]);
          else url.searchParams.delete(k);
        }
        history.replaceState(null, "", url);
      }
    };

    chips.forEach((c) =>
      c.addEventListener("click", () => {
        const value = c.dataset.value || "";
        filter.tag = filter.tag === value ? "" : value;
        applyFilter();
      }),
    );

    const visibleOptions = () => options.filter((o) => !o.hidden);
    const setActive = (i: number) => {
      const vis = visibleOptions();
      options.forEach((o) => o.classList.remove("is-active"));
      if (!vis.length) return;
      active = (i + vis.length) % vis.length;
      vis[active].classList.add("is-active");
      vis[active].scrollIntoView({ block: "nearest" });
    };
    const searchOptions = () => {
      const q = (locSearch?.value || "").trim().toLowerCase();
      options.forEach((o) => {
        const v = o.dataset.value || "";
        o.hidden = !!q && !v.toLowerCase().includes(q);
      });
      const any = visibleOptions().length > 0;
      if (locEmpty) locEmpty.hidden = any;
      setActive(0);
    };
    const openPicker = () => {
      if (!locPanel || !locToggle) return;
      locPanel.hidden = false;
      locToggle.setAttribute("aria-expanded", "true");
      if (locSearch) locSearch.value = "";
      searchOptions();
      locSearch?.focus();
    };
    const closePicker = () => {
      if (!locPanel || !locToggle) return;
      locPanel.hidden = true;
      locToggle.setAttribute("aria-expanded", "false");
    };
    const pickLocation = (value: string) => {
      filter.location = value;
      applyFilter();
      closePicker();
      locToggle?.focus();
    };

    locToggle?.addEventListener("click", () =>
      locPanel?.hidden ? openPicker() : closePicker(),
    );
    locSearch?.addEventListener("input", searchOptions);
    locPanel?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        const pick = visibleOptions()[active];
        if (pick) pickLocation(pick.dataset.value || "");
      } else if (e.key === "Escape") {
        e.stopPropagation();
        closePicker();
        locToggle?.focus();
      }
    });
    options.forEach((o) =>
      o.addEventListener("click", () => pickLocation(o.dataset.value || "")),
    );
    document.addEventListener("click", (e) => {
      if (picker && !picker.contains(e.target as Node)) closePicker();
    });

    const params = new URLSearchParams(location.search);
    const wantTag = params.get("tag") || "";
    if (wantTag && chips.some((c) => c.dataset.value === wantTag))
      filter.tag = wantTag;
    const wantLoc = params.get("location") || "";
    if (wantLoc && options.some((o) => o.dataset.value === wantLoc))
      filter.location = wantLoc;
    if (filter.tag || filter.location) applyFilter(false);

    const stopVideo = () => {
      vid.pause();
      vid.removeAttribute("src");
      vid.load();
    };

    const show = (i: number) => {
      const vis = visible();
      if (!vis.length) return;
      current = (i + vis.length) % vis.length;
      const d = vis[current].dataset;
      const isVideo = d.type === "video";

      stopVideo();
      img.hidden = isVideo;
      vid.hidden = !isVideo;
      if (isVideo) {
        vid.poster = d.poster || "";
        vid.src = d.src || "";
        vid.play().catch(() => {});
      } else {
        img.src = d.src || "";
        img.alt = d.alt || "";
      }
      caption.textContent = [d.caption, d.location].filter(Boolean).join(" · ");
      modal.classList.add("open");

      // Preload neighbouring photos so arrowing feels instant.
      for (const j of [current + 1, current - 1]) {
        const n = vis[(j + vis.length) % vis.length].dataset;
        if (n.type !== "video") new Image().src = n.src || "";
      }
    };
    const close = () => {
      stopVideo();
      modal.classList.remove("open");
    };

    items.forEach((item) =>
      item.addEventListener("click", () => show(visible().indexOf(item))),
    );
    closeBtn?.addEventListener("click", close);
    prevBtn?.addEventListener("click", () => show(current - 1));
    nextBtn?.addEventListener("click", () => show(current + 1));
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    document.addEventListener("keydown", (e) => {
      if (!modal.classList.contains("open")) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(current - 1);
      else if (e.key === "ArrowRight") show(current + 1);
    });
  }

  init();
</script>
