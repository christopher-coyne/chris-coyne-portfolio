---
import { Icon } from "astro-icon/components";

const path = Astro.url.pathname;
const current = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const links = [
  { href: "/", label: "Home" },
  { href: "/art", label: "Art" },
  { href: "/blog", label: "Blog" },
];
---

<div class="side-col">
  <aside class="hero">
    <div class="hero-band">
      <h1><a href="/">Chris Coyne</a></h1>
      <button
        id="navToggle"
        class="nav-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="heroBody"
      >
        <Icon name="mdi:menu" size={22} class="nav-toggle-icon" />
      </button>
    </div>

    <div class="hero-body" id="heroBody">
      <nav class="site-nav" aria-label="Site">
        <span class="side-label">Pages</span>
        {
          links.map((l) => (
            <a
              href={l.href}
              aria-current={current(l.href) ? "page" : undefined}
              data-astro-prefetch="hover"
            >
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="hero-contact">
        <a class="btn btn-primary" href="mailto:christcoyne@gmail.com"
          >Email me</a
        >
        <button
          id="themeToggle"
          class="btn btn-primary btn-icon"
          aria-label="Toggle dark mode"
        >
          <Icon name="mdi:white-balance-sunny" size={15} />
        </button>
      </div>
    </div>
  </aside>

  <div class="toc-card" id="toc-group" hidden>
    <span class="side-label">On this page</span>
    <div id="toc-list" class="toc-list"></div>
  </div>
</div>

<style>
  .hero {
    background: var(--tile);
    border-radius: 3px;
    padding: 0 16px 14px;
    display: flex;
    flex-direction: column;
  }

  .hero-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background-color: var(--accent);
    background-image: var(--dots-a);
    background-size: 72px 72px;
    color: #fff;
    margin: 0 -16px 12px;
    padding: 12px 16px 11px;
    border-radius: 3px 3px 0 0;
  }

  .hero h1 {
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(20px, 2.3vw, 24px);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.015em;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: -4px -6px -4px 0;
    color: #fff;
    border-radius: 4px;
  }

  .nav-toggle:hover,
  .nav-toggle:focus-visible {
    background: rgba(255, 255, 255, 0.15);
  }

  .nav-toggle:focus-visible {
    outline-color: #fff;
  }

  .nav-toggle-icon {
    transition: transform 0.2s ease;
  }

  .hero.is-open .nav-toggle-icon {
    transform: rotate(90deg);
  }

  .hero h1 a {
    color: inherit;
    text-decoration: none;
  }

  @keyframes dither-flicker {
    0%,
    100% {
      background-image: var(--dots-a);
    }
    33% {
      background-image: var(--dots-b);
    }
    66% {
      background-image: var(--dots-c);
    }
  }

  .hero-band:hover {
    animation: dither-flicker 0.45s steps(1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-band:hover {
      animation: none;
    }
  }

  .side-label {
    display: block;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-faint);
    margin-bottom: 1px;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    margin-top: 14px;
  }

  .site-nav a {
    font-size: 16.5px;
    color: var(--ink-soft);
    text-decoration: none;
    text-align: left;
    padding: 5px 9px;
    margin-left: -9px;
    margin-right: -9px;
    border-radius: 4px;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    background: var(--hover-wash);
    color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
  }

  .hero-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    margin-top: 22px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    line-height: 1;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    padding: 5px 11px;
    border-radius: var(--radius);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    background: var(--accent);
    color: #fff;
  }

  .btn-icon {
    width: 30px;
    padding: 0;
  }

  /* table of contents */
  .toc-card {
    background: var(--tile);
    border-radius: 3px;
    padding: 14px 16px;
  }

  .toc-card .side-label {
    margin-bottom: 8px;
  }

  .toc-list {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1px;
  }

  .toc-list :global(.toc-item) {
    display: block;
    font-size: 14.5px;
    color: var(--ink-faint);
    line-height: 1.4;
    text-align: left;
    text-decoration: none;
    padding: 4px 9px;
    margin-left: -9px;
    margin-right: -9px;
    border-radius: 4px;
  }

  .toc-list :global(.toc-item.is-sub) {
    padding-left: 22px;
  }

  .toc-list :global(.toc-item:hover),
  .toc-list :global(.toc-item:focus-visible) {
    background: var(--hover-wash);
    color: var(--accent);
  }

  .toc-list :global(.toc-item.is-current) {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .toc-card {
      display: none;
    }
    .hero {
      padding-bottom: 0;
    }
    .hero-band {
      margin-bottom: 0;
      border-radius: 3px;
    }
    .nav-toggle {
      display: inline-flex;
    }
    .hero-body {
      display: none;
      padding-bottom: 14px;
    }
    .hero.is-open .hero-body {
      display: block;
    }
    .hero.is-open .hero-band {
      border-radius: 3px 3px 0 0;
    }
  }
</style>

<script>
  function init() {
    const hero = document.querySelector(".hero");
    const navToggle = document.getElementById("navToggle");
    if (hero && navToggle) {
      const setOpen = (open: boolean) => {
        hero.classList.toggle("is-open", open);
        navToggle.setAttribute("aria-expanded", String(open));
      };
      navToggle.addEventListener("click", () =>
        setOpen(!hero.classList.contains("is-open")),
      );
      hero
        .querySelectorAll(".site-nav a")
        .forEach((a) => a.addEventListener("click", () => setOpen(false)));
      document.addEventListener("click", (e) => {
        if (!hero.contains(e.target as Node)) setOpen(false);
      });
    }

    const themeToggleButton = document.getElementById("themeToggle");
    if (themeToggleButton) {
      themeToggleButton.addEventListener("click", () => {
        const theme = localStorage.getItem("theme") || "light";
        const newTheme = theme === "dark" ? "light" : "dark";
        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      });
    }
  }

  init();
</script>
